# dependencies / build
node_modules/
dist/

# tests
test-results/
playwright-report/
coverage/

# pipeline data (never commit raw data, see CLAUDE.md)
pipeline/raw/
pipeline/work/
__pycache__/
.pytest_cache/

# placeholder glb is generated at build time only when no pipeline manifest exists
